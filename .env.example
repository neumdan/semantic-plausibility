# Copy to .env. Never commit actual secrets. The default review is synthetic/offline.
SQC_CONFIG_FILE=pipeline.example.toml

# Refer to these names in TOML only when the corresponding source is enabled.
LOINC_FHIR_USERNAME=
LOINC_FHIR_PASSWORD=
TX_FHIR_BEARER_TOKEN=
PUBMED_API_KEY=
LAB_DB_USER=
LAB_DB_PASSWORD=
LAB_DB_DSN=

# Alternatively reference local/secrets/ files with *_FILE / *_file in TOML.
# Optional libpq CA file inside the mounted local directory, e.g. PGSSLROOTCERT.
# PGSSLROOTCERT=/app/local/db-ca.pem

# Optional local inference. The default runner does not start Ollama.
SQC_OLLAMA_PORT=11434
# OLLAMA_IMAGE=docker.io/ollama/ollama:0.34.1
