# Copy to .env. Pipeline settings live in pipeline.toml; no shell exports are needed.
# Optional Compose file selector. Python selects its TOML through --config instead.
SQC_CONFIG_FILE=pipeline.toml
# Select another TOML only for another source/profile; research uses the same file.
# Real public terminology lookups are enabled in the example TOML.

# Refer to these names in TOML only when the corresponding source is enabled.
LOINC_FHIR_USERNAME=
LOINC_FHIR_PASSWORD=
TX_FHIR_BEARER_TOKEN=
PUBMED_API_KEY=
LAB_DB_USER=
LAB_DB_PASSWORD=
LAB_DB_DSN=
BFARM_PACKAGE_TOKEN=
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=

# Alternatively reference local/secrets/ files with *_FILE / *_file in TOML.
# Optional libpq CA file inside the mounted local directory, e.g. PGSSLROOTCERT.
# PGSSLROOTCERT=/app/local/db-ca.pem

# Model addresses are in TOML (base_url / container_base_url).
# Only needed if you explicitly choose base_url_env="LOCAL_MODEL_BASE_URL":
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# The default check does not start Ollama.
# Leave a port value empty for automatic localhost allocation (used by the example script).
# Unset variables use 11434 / 8081 / 8082 respectively.
SQC_OLLAMA_PORT=11434
# Stable across Compose projects. To reuse old weights, enter their volume name.
SQC_OLLAMA_VOLUME=semantic-plausibility-ollama
# SQC_MATCHBOX_PORT=8081
# SQC_BLAZE_PORT=8082
# OLLAMA_IMAGE=docker.io/ollama/ollama:0.34.1

# Optional host input directory, mounted read-only at /input (default ../input).
# SQC_INPUT_DIR=../input

# Optional local catalogue / generated validator directory (default ./local).
# The example test script isolates these files in local/podman-examples.
# SQC_LOCAL_DIR=./local

# Optional synthetic PostgreSQL example (compose.examples.yaml); choose your own password.
# EXAMPLE_DB_USER=example
# EXAMPLE_DB_PASSWORD=choose-a-local-example-password
