%% Same node/edge contract as architecture.svg.
flowchart TD
    INPUT["Input and source contract<br/>LIS / CSV / DB exports or actual FHIR Bundle / NDJSON<br/>Names, code/system/version, value, unit/system<br/>All reference intervals, specimen, method and known counts"]
    CONFIG["One TOML configuration<br/>Input/output and columns; pinned MII guide/profile<br/>Primary / source / optional terminology services<br/>Local model and credentials by environment/file reference"]
    VALIDATE["Full FHIR validation when the input is FHIR<br/>Local Matchbox + official HL7 validator, or MII validator<br/>Pinned guide and dependencies; local Blaze terminology<br/>Retain OperationOutcome; unavailable stays unverified"]
    GROUP["Standardise and aggregate locally<br/>Preserve the complete semantic set and context<br/>DuckDB: distinct sets or items with source IDs<br/>Known frequencies: mean/SE and median/IQR"]
    LOCAL["Downloaded terminology<br/>Real BfArM JSON / source catalogue<br/>Versioned labels and exact membership<br/>Supplements do not prove conversions"]
    CHECK["Laboratory semantic checks<br/>Source validity and target profile fit<br/>LOINC axes / UCUM grammar and factors<br/>Numeric values and full reference context<br/>Explicit transformation proposals"]
    API["Configured terminology APIs<br/>NLM UCUM / LOINC / selected services<br/>Exact lookups; known versions and coverage<br/>Only enabled services are contacted"]
    REPORT["Audited check report<br/>CSV / HTML, summary, evidence and hash-chained log<br/>Formal FHIR outcomes and semantic findings stay separate<br/>Source set → linked terminology → complete proposal"]
    RESEARCH["Separate evidence research with local Ollama<br/>LOINC pages + Europe PMC / PubMed abstracts<br/>Sourced alternatives, quoted values, units and intervals<br/>Article title / URL / DOI, response hash and retrieval time<br/>Prompts and guarded replies in the research trace"]
    REVIEW["Clinician review and future mapping reuse<br/>Review semantic correctness and evidence applicability<br/>Approve/reject/defer/revoke code, name, unit and factor<br/>Scoped registry rechecks target and transformation<br/>Apply in ETL, then validate the resulting FHIR resources"]
    INPUT --> |"FHIR"| VALIDATE
    CONFIG --> |"guide"| VALIDATE
    VALIDATE --> |"attach outcomes"| GROUP
    INPUT --> |"CSV / DB"| GROUP
    GROUP --> |"sets"| CHECK
    LOCAL --> |"files"| CHECK
    API --> |"API"| CHECK
    CHECK --> |"checks + proposals"| REPORT
    REPORT --> |"optional evidence pass"| RESEARCH
    REPORT --> |"review"| REVIEW
    RESEARCH --> |"dossier"| REVIEW
    classDef normal fill:#ffffff,stroke:#b7cec9,color:#142d42
    classDef teal fill:#eef7f4,stroke:#b7cec9,color:#142d42
    class VALIDATE,CHECK,REPORT,RESEARCH,REVIEW teal
