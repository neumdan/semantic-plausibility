%% Same node/edge contract as decision-flow.svg.
flowchart TD
    INPUT["Input contract + selected profile<br/>Valid headers/types, frequency contract, versions, full reference/context guards<br/>Unsupported/malformed contracts fail with a redacted audit; valid rows continue"]
    SOURCE["Select configured evidence per lookup: A, B or both<br/>A: previously installed files / captured pack · B: enabled API and credentials<br/>Offline mode disables remote adapters; no fallback to an unconfigured API"]
    LOCAL["A · Ready local terminology files<br/>package-init is a separate setup command<br/>Accept conditions and pin editions before download<br/>Reference lookup.path / systems; input.snapshot for pack<br/>Supplements provide labels; coverage stays explicit"]
    API["B · Configured API and credentials<br/>Set type, endpoint and systems where required<br/>Use .env / secret-file references; select release/language<br/>Require network.mode=lookups and lookup.enabled=true<br/>Public services may need no credentials"]
    LOOKUP["Validate declared code/system and unit/system<br/>Read local evidence and/or query selected services; retain source and edition"]
    INVALID["Confirmed invalid<br/>Keep deterministic error<br/>Assess remaining fields"]
    KNOWN["Verified code / unit<br/>Identity or syntax supported<br/>Still check semantic fit"]
    UNKNOWN["Not verified<br/>Absent / partial / unavailable<br/>Unavailable is not invalid"]
    FIT["Check supplied aliases, LOINC axes / example units and context<br/>Names and unit syntax alone cannot prove fit; examples are not a universal whitelist"]
    MATCH["Documented unchanged fit<br/>Continue to values/references<br/>Clinical applicability remains<br/>a separate review question"]
    CONVERT["Verified linear conversion<br/>Propose target + numeric factor<br/>Check each reference bound too<br/>Never rewrite source values"]
    AMBIG["Ambiguous / mismatch<br/>10*6 without a denominator<br/>First example is a candidate<br/>No guessed transformation"]
    RESEARCH["Explicit candidate sources and optional local research<br/>SemLookP names; catalogue → local model → quoted lookup pages → PubMed candidates<br/>Candidate searches are opt-in; offline mode has no remote research"]
    NUMERIC["Values and reference metadata<br/>Finite numbers, ordered bounds, supplied units and interval context<br/>Out-of-reference is descriptive; it is not automatically a data error<br/>Evidence of clinical plausibility requires method/population review"]
    OUTPUT["Write separate checks, credibility and explicit readiness denominators<br/>Priority: error → unclear → suggestion → passed<br/>Readiness is a numeric semantic proxy, not MII certification or clinical approval"]
    REVIEW["Expert adjudication → approved site mapping → formal FHIR validation<br/>Patient Observations are never generated from aggregate means"]
    INPUT --> SOURCE
    SOURCE --> |"A"| LOCAL
    SOURCE --> |"B"| API
    LOCAL --> LOOKUP
    API --> LOOKUP
    LOOKUP --> INVALID
    LOOKUP --> KNOWN
    LOOKUP --> UNKNOWN
    INVALID --> FIT
    KNOWN --> FIT
    UNKNOWN --> FIT
    FIT --> MATCH
    FIT --> CONVERT
    FIT --> AMBIG
    MATCH --> RESEARCH
    CONVERT --> RESEARCH
    AMBIG --> RESEARCH
    RESEARCH --> NUMERIC
    NUMERIC --> OUTPUT
    OUTPUT --> REVIEW
    classDef normal fill:#f3f7fa,stroke:#c4d5df,color:#142d42
    class INPUT,SOURCE,LOCAL,API,LOOKUP,UNKNOWN,FIT,CONVERT,AMBIG,NUMERIC,REVIEW normal
    classDef teal fill:#eef7f4,stroke:#a8cfc6,color:#142d42
    class KNOWN,MATCH,RESEARCH,OUTPUT teal
    classDef error fill:#fcf1f3,stroke:#ecc7cf,color:#142d42
    class INVALID error
