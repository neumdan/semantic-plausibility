{
  "version": "2026-10-15",
  "note": "Declared systems supported by configured adapters. Profile bindings and server coverage must be verified separately; RxNorm is an optional international source, not a required MII medication binding.",
  "systems": [
    {
      "name": "LOINC",
      "canonical": "http://loinc.org",
      "scope": [
        "laboratory"
      ],
      "check": "CodeSystem/$lookup",
      "configured_by": "lookups.loinc / lookups.loinc_local",
      "source": "https://loinc.org/kb/api/fhir/codesystem"
    },
    {
      "name": "UCUM",
      "canonical": "http://unitsofmeasure.org",
      "scope": [
        "laboratory",
        "medication_quantity"
      ],
      "check": "NLM UCUM validation and conversion",
      "configured_by": "lookups.ucum",
      "source": "https://ucum.nlm.nih.gov/ucum-service.html"
    },
    {
      "name": "SNOMED CT",
      "canonical": "http://snomed.info/sct",
      "scope": [
        "laboratory",
        "medication"
      ],
      "check": "CodeSystem/$validate-code",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://terminologien.bfarm.de/index.html",
      "access": "licensed national edition may be required"
    },
    {
      "name": "RxNorm",
      "canonical": "http://www.nlm.nih.gov/research/umls/rxnorm",
      "scope": [
        "medication",
        "medication_ingredient"
      ],
      "check": "CodeSystem/$validate-code and $lookup",
      "configured_by": "lookups.rxnorm",
      "source": "https://www.nlm.nih.gov/research/umls/rxnorm/overview.html",
      "note": "Optional international coding; the example checks ingredient RxCUI 161. This does not verify a German product or MII binding."
    },
    {
      "name": "BfArM ATC DE",
      "canonical": "http://fhir.de/CodeSystem/bfarm/atc",
      "scope": [
        "medication"
      ],
      "check": "CodeSystem/$validate-code with version",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://terminologien.bfarm.de/index.html"
    },
    {
      "name": "WHO ATC",
      "canonical": "http://www.whocc.no/atc",
      "scope": [
        "medication"
      ],
      "check": "CodeSystem/$validate-code with version",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://www.whocc.no/atc_ddd_index/"
    },
    {
      "name": "ASK",
      "canonical": "http://fhir.de/CodeSystem/ask",
      "scope": [
        "medication"
      ],
      "check": "CodeSystem/$validate-code",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://www.medizininformatik-initiative.de/Kerndatensatz/KDS_Medikation_2026/MIIIGModulMedikation-TechnischeImplementierung-Terminologien.html"
    },
    {
      "name": "PZN",
      "canonical": "http://fhir.de/CodeSystem/ifa/pzn",
      "scope": [
        "medication"
      ],
      "check": "CodeSystem/$validate-code",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://www.bfarm.de/DE/Arzneimittel/_FAQ/Zulassung/Allgemeine-Fragen/faq-liste.html",
      "note": "PZN is assigned by IFA; BfArM is not the issuer."
    },
    {
      "name": "UNII",
      "canonical": "http://fdasis.nlm.nih.gov",
      "scope": [
        "medication"
      ],
      "check": "CodeSystem/$validate-code",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://precision.fda.gov/uniisearch"
    },
    {
      "name": "EDQM Standard Terms",
      "canonical": "http://standardterms.edqm.eu",
      "scope": [
        "medication_form",
        "medication_route"
      ],
      "check": "CodeSystem/$validate-code",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://standardterms.edqm.eu/",
      "access": "registration and terms apply"
    },
    {
      "name": "CAS",
      "canonical": "http://terminology.hl7.org/CodeSystem/CAS",
      "scope": [
        "medication_ingredient"
      ],
      "check": "CodeSystem/$validate-code",
      "configured_by": "lookups.NAME (fhir, fhir_artifacts, csv or sqlite)",
      "source": "https://www.medizininformatik-initiative.de/Kerndatensatz/KDS_Medikation_2026/MIIIGModulMedikation-Release-Notes.html"
    },
    {
      "name": "WHO ICD-11 MMS",
      "canonical": "http://id.who.int/icd/release/11/mms",
      "scope": [
        "diagnosis_lookup"
      ],
      "check": "Pinned WHO MMS codeinfo and entity lookup; stem codes only",
      "configured_by": "lookups.icd11",
      "source": "https://icd.who.int/icdapi",
      "access": "OAuth2 client credentials; explicit release/language",
      "note": "Separate terminology lookup; Condition batch assessment is later work."
    }
  ]
}
