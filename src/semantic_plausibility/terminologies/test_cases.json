{
  "note": "Small reference cases, not a finite UCUM unit catalogue. NLM validates a compositional grammar. Input CSV units are additional observations without an invented expected verdict.",
  "sources": ["https://ucum.nlm.nih.gov/ucum-service.html", "https://ucum.org/ucum"],
  "code_examples": [
    {"system": "http://snomed.info/sct", "code": "373873005", "source": "https://hl7.org/fhir/R4/valueset-medication-codes.json.html"},
    {"system": "http://fdasis.nlm.nih.gov", "code": "362O9ITL9D", "source": "https://precision.fda.gov/uniisearch/srs/unii/362o9itl9d"},
    {"system": "http://fhir.de/CodeSystem/bfarm/atc", "code": "N02BE01", "source": "https://www.bfarm.de/SharedDocs/Downloads/DE/Arzneimittel/Zulassung/amInformationen/Lieferengpaesse/Dringlichkeitsliste_arzneimittelliste_stand_20250401_pdf.pdf?__blob=publicationFile"},
    {"system": "http://terminology.hl7.org/CodeSystem/CAS", "code": "103-90-2", "source": "https://precision.fda.gov/uniisearch/srs/unii/362o9itl9d"}
  ],
  "units": [
    {"unit": "g/dL", "expected_valid": true},
    {"unit": "g/dl", "expected_valid": true, "note": "Lowercase l is valid UCUM; normalization alone is not a repair of an invalid code."},
    {"unit": "g/L", "expected_valid": true},
    {"unit": "mg/dL", "expected_valid": true},
    {"unit": "mg/mL", "expected_valid": true},
    {"unit": "ng/mL", "expected_valid": true},
    {"unit": "ug/mL", "expected_valid": true},
    {"unit": "mmol/L", "expected_valid": true},
    {"unit": "umol/L", "expected_valid": true},
    {"unit": "10*3/uL", "expected_valid": true},
    {"unit": "10*6/uL", "expected_valid": true},
    {"unit": "10*9/L", "expected_valid": true},
    {"unit": "10*6", "expected_valid": true, "note": "A scale factor without a denominator is not a complete cell-concentration interpretation."},
    {"unit": "/uL", "expected_valid": true},
    {"unit": "1", "expected_valid": true},
    {"unit": "%", "expected_valid": true},
    {"unit": "[IU]/L", "expected_valid": true},
    {"unit": "U/L", "expected_valid": true},
    {"unit": "mm[Hg]", "expected_valid": true},
    {"unit": "kg", "expected_valid": true},
    {"unit": "Cel", "expected_valid": true},
    {"unit": "K", "expected_valid": true},
    {"unit": "mL", "expected_valid": true},
    {"unit": "mg/ml...", "expected_valid": false, "note": "Truncated notation needs source clarification."},
    {"unit": "10^6/uL", "expected_valid": true, "note": "UCUM defines both 10^ and 10* for powers of ten. Complete denominator retained."},
    {"unit": "mmHg", "expected_valid": false},
    {"unit": "not-a-unit", "expected_valid": false}
  ],
  "conversions": [
    {"source_unit": "g/dl", "target_unit": "g/dL", "expected_factor": "1"},
    {"source_unit": "g/dL", "target_unit": "g/L", "expected_factor": "10"},
    {"source_unit": "mg/mL", "target_unit": "g/dL", "expected_factor": "0.1"},
    {"source_unit": "ug/mL", "target_unit": "mg/L", "expected_factor": "1"},
    {"source_unit": "10*3/uL", "target_unit": "10*9/L", "expected_factor": "1"},
    {"source_unit": "10*6/uL", "target_unit": "10*9/L", "expected_factor": "1000"},
    {"source_unit": "g/dL", "target_unit": "s", "expected_factor": null, "note": "Incompatible dimensions."},
    {"source_unit": "mg/dL", "target_unit": "mmol/L", "expected_factor": null, "note": "Requires substance-specific molecular weight; not a generic factor."},
    {"source_unit": "Cel", "target_unit": "K", "expected_factor": null, "note": "Affine conversion with offset is unsupported by the current factor-only interface."},
    {"source_unit": "K", "target_unit": "Cel", "expected_factor": null, "note": "An affine conversion must never be reported as a multiplicative factor."}
  ]
}
